# Port (Render sets this automatically to 10000 or process.env.PORT)
PORT=3001

# Database connection string
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET=super-secure-secret-key-change-in-production

# Node environment
NODE_ENV=development

# Allowed CORS origins (* for any or https://your-frontend.vercel.app)
CORS_ORIGINS=*

# --- LuckyBet / gw-lucky-bet feed (KRYESORI: futboll real, të gjitha tregjet) ---
# Manuali: ../docs/LUCKYBET-FEED-API.md   |   Testi: npx tsx luckybet-probe.ts
#                                                  npx tsx luckybet-smoke.ts
LUCKYBET_PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LUCKYBET_API_HOST=api-gateway.gw-lucky-bet.com
LUCKYBET_LANGUAGE=en-001
# Interval i sinkronizimit të listës së ndeshjeve (ms)
LUCKYBET_SYNC_MS=60000
# Sa ndeshje prematch abonohen në websocket për kuota (përveç të gjitha live)
# LUCKYBET_PREMATCH_WS_LIMIT=15
# Sa milisekonda dëgjon websocket-i në skedarët e testit (default 20000)
# LUCKYBET_WATCH_MS=20000

# --- Bzzoiro (VJETËR, opsional) ---
# Feed-i kryesor tani është LuckyBet. Bzzoiro ndizet vetëm nëse e aktivizon me dorë:
ENABLE_BZZOIRO_FEED=0
BZZOIRO_API_KEY=your_bzzoiro_api_key_here
# BZZOIRO_API_BASE=https://sports.bzzoiro.com
# ODDS_EVENT_LIMIT=60