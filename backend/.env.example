# Port (Render sets this automatically to 10000 or process.env.PORT)
PORT=3001

# Database — Postgres (NEON). Krijo projekt falas në https://neon.tech
# dhe ngjit këtu "Connection string"-in (përfisha schema=... në fund):
# SHTO gjithmone connection_limit & pool_timeout ne fund te URL-se — pa ata,
# feed-i i kuotave mbush pool-in (limit 5) dhe kuotat nuk shkruhen (timeout).
DATABASE_URL="postgresql://user:password@ep-name-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=10&pool_timeout=30"

# JWT Secret Key
JWT_SECRET=super-secure-secret-key-change-in-production

# Node environment
NODE_ENV=development

# Allowed CORS origins (* for any or https://your-frontend.vercel.app)
CORS_ORIGINS=*

# --- LuckyBet / gw-lucky-bet feed (futboll real: ndeshje + të gjitha tregjet + kuota live) ---
# Manuali: ../docs/LUCKYBET-FEED-API.md   |   Testi: npx tsx luckybet-probe.ts
LUCKYBET_PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LUCKYBET_API_HOST=api-gateway.gw-lucky-bet.com
LUCKYBET_LANGUAGE=en-001
