# Port (Render sets this automatically to 10000 or process.env.PORT)
PORT=3001

# Database — Postgres (SUPABASE). Krijo projekt falas ne https://supabase.com
# Dashboard -> Connect -> "Session pooler" (port 5432) dhe kopjo host-in.
#
# KUJDES (shume e rendesishme): host-i direkt "db.<project-ref>.supabase.co" del VETEM
# ne IPv6. Render.com (dhe shume rrjeta lokale) NUK kane IPv6 dalje, keshtu qe lidhja
# deshton me ENOTFOUND. Gjithmone perdor pooler-in Supavisor (IPv4):
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#   (Session pooler = port 5432, i pershtatshem per Prisma ne server te perhershem si Render)
# SHTO gjithmone sslmode=require + connection_limit & pool_timeout ne fund te URL-se — pa ata,
# feed-i i kuotave mbush pool-in dhe kuotat nuk shkruhen (timeout).
DATABASE_URL="postgresql://postgres.tvynxkthwxlxjlllehgo:YOUR-DB-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20"

# JWT Secret Key
JWT_SECRET=super-secure-secret-key-change-in-production

# Node environment
NODE_ENV=development

# Allowed CORS origins (* for any or https://your-frontend.vercel.app)
CORS_ORIGINS=*

# --- LuckyBet / gw-lucky-bet feed (futboll real: ndeshje + të gjitha tregjet + kuota live) ---
# Manuali: ../docs/LUCKYBET-FEED-API.md   |   Testi: npx tsx luckybet-probe.ts
LUCKYBET_PARTNER_ID=d3edfa27-7cac-4f77-9e6e-4e2fa2d1ab5f
LUCKYBET_API_HOST=api-gateway.gw-lucky-bet.com
LUCKYBET_LANGUAGE=en-001
